
; ******** Source: u:\Programming\c64\assembler\the_dungeons_acme\src\the_dungeons.asm
     1                          ; ============================================================
     2                          ; the_dungeons.asm
     3                          ; Top-level build - assembles the reconstructed decompressed
     4                          ; image directly (no depacker needed; this IS the runtime data).
     5                          ;
     6                          ; NOTE: each include file assembles at its own * = address, with
     7                          ; two small unavoidable gaps between them that your build/linker
     8                          ; step needs to zero-pad when producing the final flat PRG:
     9                          ;   $083F-$0840  dead space before the sprite pool (sprite VIC
    10                          ;                block numbers are hardcoded in basic_program, so
    11                          ;                the pool can't move - see Tier 3 scope doc)
    12                          ;   $1201-$1220  8 unidentified filler bytes before ml_saveload
    13                          ; Everything else is back-to-back with no gaps, including
    14                          ; game_state.asm -> basic_program.asm -> leftover_items.asm ->
    15                          ; ml_entry.asm (the C7 padding that used to precede ml_entry at
    16                          ; $6500 was trimmed - it now sits at $646C, see include/README.md).
    17                          ; ============================================================
    18                          

; ******** Source: \src\include\constants.asm
     1                          ; ============================================================
     2                          ; constants.asm
     3                          ; The Dungeons (Brian & Marian Clark, 1983) - reconstruction
     4                          ; Confirmed labels/addresses from decompressed-image analysis
     5                          ; ============================================================
     6                          
     7                          ; --- BASIC zero page (used by the ML entry stub at $6500) ---
     8                          TXTTAB_LO   = $2B      ; start-of-BASIC-program pointer, low byte
     9                          TXTTAB_HI   = $2C      ; start-of-BASIC-program pointer, high byte
    10                          VARTAB_LO   = $2D      ; start-of-variables pointer, low byte
    11                          VARTAB_HI   = $2E      ; start-of-variables pointer, high byte
    12                          ARYTAB_LO   = $2F      ; start-of-arrays pointer, low byte
    13                          ARYTAB_HI   = $30      ; start-of-arrays pointer, high byte
    14                          STREND_LO   = $31      ; end-of-arrays/string-storage pointer, low byte
    15                          STREND_HI   = $32      ; end-of-arrays/string-storage pointer, high byte
    16                          
    17                          ; --- BASIC ROM entry points used by the ML entry stub ---
    18                          ; (Standard C64 BASIC V2 ROM addresses - real ROM required to run)
    19                          BASIC_LINKPRG = $A660  ; relink BASIC program line pointers
    20                          BASIC_CLR     = $A68E  ; clear variables / reset stack (CLR-equivalent)
    21                          BASIC_MAIN    = $A7AE  ; main statement-execution dispatcher (GONE/warm start)
    22                          
    23                          ; --- KERNAL vectors used by the save/load routine ($1218-$125F) ---
    24                          KERNAL_SETLFS = $FFBA
    25                          KERNAL_SETNAM = $FFBD
    26                          KERNAL_LOAD   = $FFD5
    27                          KERNAL_SAVE   = $FFD8
    28                          
    29                          ; --- Save-state block used by SYS4640 (save) / SYS4676 (load) ---
    30                          ; Filename buffer + save-state block, built by BASIC lines 710-712 / 1140-1142
    31                          NAME_BUFFER   = $1C00  ; "DATA1" filename text lives here (5 bytes)
    32                          SAVESTATE_LO  = $1C00  ; save/load range low byte
    33                          SAVESTATE_HI  = $2000  ; save/load range high byte (exclusive)
    34                          
    35                          ; --- Game-state sub-arrays within the save-state block ---
    36                          ; Computed at runtime by BASIC line 243: D=30*256:R=D-99:TR=R-18:Q=18:T=TR-100:MS=T-100
    37                          ; SR computed by line 167/266: SR=MS-30
    38                          SR_PTR        = $1CA5  ; save/restore pointer block (~30 bytes)
    39                          MS_ARRAY      = $1CC3  ; monster status per room (~100 bytes)
    40                          T_ARRAY       = $1D27  ; trap flags per room (~100 bytes)
    41                          TR_ARRAY      = $1D8B  ; target-room scratch (18 bytes), zeroed at game start
    42                          R_ARRAY       = $1D9D  ; room-connection data (99 bytes), re-read from DATA
    43                                                  ; statements every game start (BASIC line 1064) -
    44                                                  ; does NOT need to be byte-exact in the image.
    45                          D_ARRAY       = $1E00  ; THE DUNGEON EXIT MATRIX. Indexed as
    46                                                  ; PEEK(D+room*4+direction) - BASIC lines 161/163.
    47                                                  ; Never written by the BASIC program itself, so
    48                                                  ; MUST be present as static data at load time.
    49                          
    50                          ; --- Game entry / layout (decompressed image addresses) ---
    51                          SPRITE_POOL_START   = $0840   ; 36 sprite blocks (#33-68), 64 bytes each
    52                          SPRITE_POOL_END     = $1140
    53                          WALL_TILES_START    = $1140   ; custom wall/gate tile bitmaps
    54                          ML_SAVELOAD_START   = $1218   ; tape SAVE/LOAD subroutines
    55                          LOOKUP_TABLE_START  = $1260   ; unresolved lookup/translation table
    56                          CHARSET_COPY_START  = $1400   ; standard C64 charset copied to RAM
    57                          BASIC_PROGRAM_START = $2001   ; main game program (476 lines)
    58                          BASIC_PROGRAM_END   = $6271   ; corrected - was $6269 (8 bytes short of the
    59                                                         ; true end-of-program null terminator; see
    60                                                         ; include/README.md "Tokenizer fixes")
    61                          LEFTOVER_ITEMS_START = $6271  ; unused item data (DAGGER, HELMET, etc.)
    62                          LEFTOVER_ITEMS_END   = $646C  ; kept for historical/future reference
    63                          ML_ENTRY_STUB_START = $646C   ; hands off build -> BASIC RUN
    64                                                         ; (trimmed: originally $6500 in the source
    65                                                         ;  image with 147 bytes of $C7 padding
    66                                                         ;  before it; nothing hardcodes $6500, so
    67                                                         ;  the stub now sits right after the
    68                                                         ;  leftover item data with no gap)
    69                          
    70                          ; --- VIC-II / hardware bases referenced by the BASIC program ---
    71                          VIC_BASE      = $D000  ; "VS" in BASIC source
    72                          SPRITE_PTRS   = $07F8  ; sprite pointer table (2040-2047 decimal)
    73                          SCREEN_BASE   = $0400  ; "SC" in BASIC source
    74                          COLOR_RAM     = $D800  ; "C" in BASIC source

