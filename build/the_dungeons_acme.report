; ******** Source: \src\include\ml_saveload.asm
    12                          
    13                                  * = $1220
    14                          
    15                          ; --- SYS4640: SAVE game state to tape ---
    16                          ml_save:
    17  1220 a901                       lda #$01              ; logical file number 1
    18  1222 a0ff                       ldy #$FF              ; secondary address (unused by SAVE)
    19  1224 a201                       ldx #$01              ; device 1 = tape
    20  1226 20baff                     jsr KERNAL_SETLFS
    21                          
    22  1229 a905                       lda #$05               ; filename length = 5 ("DATA1")
    23  122b a200                       ldx #$00               ; filename pointer low byte
    24  122d a01c                       ldy #$1C               ; filename pointer high byte -> $1C00 (NAME_BUFFER)
    25  122f 20bdff                     jsr KERNAL_SETNAM
    26                          
    27  1232 a91c                       lda #$1C               ; zp $FC = start address high byte ($1C)
    28  1234 85fc                       sta $FC
    29  1236 a900                       lda #$00               ; zp $FB = start address low byte ($00)
    30  1238 85fb                       sta $FB                ; $FB/$FC now hold start address $1C00 (SAVESTATE_LO)
    31  123a a020                       ldy #$20               ; end address high byte ($20)
    32  123c a200                       ldx #$00               ; end address low byte  -> end = $2000 (SAVESTATE_HI)
    33  123e a9fb                       lda #$FB               ; A = zero-page pointer to start address
    34  1240 20d8ff                     jsr KERNAL_SAVE
    35  1243 60                         rts
    36                          
    37                          ; --- SYS4676: LOAD game state from tape ---
    38                          ml_load:
    39  1244 a901                       lda #$01               ; logical file number 1
    40  1246 a001                       ldy #$01               ; secondary address 1
    41  1248 a201                       ldx #$01               ; device 1 = tape
    42  124a 20baff                     jsr KERNAL_SETLFS
    43                          
    44  124d a905                       lda #$05               ; filename length = 5 ("DATA1")
    45  124f a200                       ldx #$00               ; filename pointer low byte
    46  1251 a01c                       ldy #$1C               ; filename pointer high byte -> $1C00 (NAME_BUFFER)
    47  1253 20bdff                     jsr KERNAL_SETNAM
    48                          
    49  1256 a900                       lda #$00               ; 0 = load to address stored in the file itself
    50  1258 a0ff                       ldy #$FF               ; (X/Y ignored since A=0)
    51  125a a2ff                       ldx #$FF
    52  125c 20d5ff                     jsr KERNAL_LOAD
    53  125f 60                         rts

