; ******** Source: \src\include\game_state.asm
     1                          ; ============================================================
     2                          ; game_state.asm
     3                          ; Game state working-storage block, INCLUDING the dungeon exit
     4                          ; matrix. This was previously omitted from the build entirely -
     5                          ; that's the "no exit doors at Gloomy Entrance" bug: room
     6                          ; movement checks PEEK(D+R%*4+F%) (BASIC line 161/163), and the
     7                          ; D array ($1E00 onward) is never written by the BASIC program
     8                          ; itself, so it MUST be present as static data from load time.
     9                          ; Leaving this region out meant every direction read as 0 (no
    10                          ; exit) for every room.
    11                          ;
    12                          ; Source: decompressed image $1C00-$2000 (1025 bytes incl. the
    13                          ; single byte at $2000, which pads right up to basic_program).
    14                          ;
    15                          ; Sub-regions within this block (see constants.asm for the
    16                          ; computed BASIC pointer values):
    17                          ;   NAME ($1C00, 5 bytes)      - tape filename buffer ("DATA1")
    18                          ;                                overwritten at runtime by BASIC
    19                          ;                                lines 176/263 - included here
    20                          ;                                mainly for completeness/save-
    21                          ;                                state round-tripping.
    22                          ;   SR   ($1CA5, ~30 bytes)    - save/restore state pointer block,
    23                          ;                                written by BASIC line 167/266.
    24                          ;   MS   ($1CC3, ~100 bytes)   - monster status per room, written
    25                          ;                                at runtime.
    26                          ;   T    ($1D27, ~100 bytes)   - trap flags per room, written at
    27                          ;                                runtime.
    28                          ;   TR   ($1D8B, 18 bytes)     - target-room scratch array,
    29                          ;                                zeroed at game start (line ~191).
    30                          ;   R    ($1D9D, 99 bytes)     - room-connection data, POKEd fresh
    31                          ;                                from DATA statements every game
    32                          ;                                start (BASIC line 1064).
    33                          ;   D    ($1E00, ~512 bytes)   - THE EXIT MATRIX. Never written by
    34                          ;                                the BASIC program - must be
    35                          ;                                preserved as static data. This is
    36                          ;                                the piece that was missing.
    37                          ;
    38                          ; Only D strictly needs to be byte-exact from the original image;
    39                          ; the others are re-initialized by the game itself at startup, but
    40                          ; are included here unchanged for a faithful, low-risk reconstruction.
    41                          ; ============================================================
    42                          
    43                                  * = SAVESTATE_LO   ; $1C00
    44                          
    45                          game_state:
    46  1c00 44415441318b6308...        !binary "/src/include/game_state_1C00.bin"
    47                          
    48                          game_state_end:

