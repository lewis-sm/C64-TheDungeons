    41                                                                    ; header for the bug this caused)

; ******** Source: \src\include\basic_program.asm
     1                          ; ============================================================
     2                          ; basic_program.asm
     3                          ; The full game - 476 lines of tokenized BASIC V2.
     4                          ; Source: decompressed image $2001-$6271 (corrected boundary -
     5                          ; the true end-of-program null terminator sits at $626F/$6270,
     6                          ; not $6269 as originally extracted; see include/README.md).
     7                          ; Human-readable, corrected detokenized listing:
     8                          ;   reference/the_dungeons.bas.txt
     9                          ; Regenerate this binary from that listing with:
    10                          ;   python3 tools/tokenizer.py  (see tools/README.md)
    11                          ;
    12                          ; This is included as a raw binary blob (tokenized form) since
    13                          ; it's BASIC, not 6502 machine code - ACME just needs to place
    14                          ; these bytes at the right address for the ML entry stub to
    15                          ; hand off into.
    16                          ; ============================================================
    17                          
    18                                  * = $2001
    19                          
    20                          basic_program:
    21  2001 2c2001008f204252...        !binary "/src/include/basic_program_2001.bin"
    22                          
    23                          basic_program_end:

